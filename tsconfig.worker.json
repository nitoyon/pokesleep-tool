{
	"compilerOptions": {
		"target": "esnext",
		"lib": ["dom", "esnext"],
		"allowJs": false,
		"noImplicitAny": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"isolatedModules": true,
		"noEmit": true
	},
	"include": ["src/util/Team/teamSimulation.worker.ts"]
}
